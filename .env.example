# Set both values explicitly outside local development.
APP_ENV=production
NODE_ENV=production

TURSO_DATABASE_URL=libsql://your-production-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

EMAIL_ENABLED=true
EMAIL_USER=no-reply@example.edu.co
EMAIL_PASS=replace-with-gmail-app-password

# Optional: Slack/Discord-compatible webhook for runtime and monitoring alerts.
ALERT_WEBHOOK_URL=

# Required only by the scheduled encrypted-backup workflow in GitHub Actions.
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-passphrase
