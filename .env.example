# Local SQLite database. For Turso, set its URL and token separately.
DATABASE_URL="file:./database/prisma/dev.db"
TURSO_DATABASE_URL="file:./database/prisma/dev.db"
TURSO_AUTH_TOKEN=""

# Generate a private random secret of at least 24 characters before starting.
JWT_SECRET=""

# Optional Gmail sender and its app password. Leave both empty to disable email.
EMAIL_USER=""
EMAIL_PASS=""
