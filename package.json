{
  "name": "sistema-escolar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.11.1": true
  },
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend --webpack",
    "start": "next start frontend",
    "lint": "eslint frontend backend",
    "typecheck": "tsc --noEmit",
    "seed:dashboard": "node --env-file=.env scripts/db/seed-dashboard-demo.mjs",
    "seed:dashboard:clean": "node --env-file=.env scripts/db/seed-dashboard-demo.mjs --clean",
    "import:11-2": "node --env-file=.env scripts/db/import-11-2.mjs",
    "migrate:salidas": "node scripts/db/apply-salidas-autorizadas-migration.mjs",
    "migrate:reportes": "node --env-file=.env scripts/db/apply-reportes-migration.mjs",
    "migrate:security": "node --env-file=.env scripts/db/apply-auth-security-migration.mjs",
    "migrate:initial-password": "node --env-file=.env scripts/db/apply-initial-password-migration.mjs",
    "auth:unlock": "node --env-file=.env scripts/db/unlock-auth-account.mjs",
    "db:migrate:staging": "node --env-file=.env.staging scripts/db/libsql-migrate.mjs apply",
    "db:migrate:staging:status": "node --env-file=.env.staging scripts/db/libsql-migrate.mjs status",
    "db:migrate:staging:dry-run": "node --env-file=.env.staging scripts/db/libsql-migrate.mjs dry-run",
    "seed:staging": "node --env-file=.env.staging scripts/db/seed-staging.mjs",
    "db:backup": "node --env-file=.env scripts/db/backup-libsql.mjs",
    "monitor:production": "node scripts/monitor-production.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
